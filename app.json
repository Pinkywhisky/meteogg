{
  "expo": {
    "name": "MeteoGG",
    "slug": "meteogg",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F8FF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meteogg.app"
    },
    "android": {
      "package": "com.meteogg.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F8FF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MeteoGG utilise votre position pour afficher la météo locale au démarrage."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d2c6c4af-83c3-441c-8618-eecb3ba23953"
      }
    }
  }
}
